{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velyq-poc",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    /*
     * Public pages are prerendered into the asset directory so Cloudflare
     * serves them without invoking the Worker — the app's SSR costs ~16ms of
     * CPU and the Workers Free allowance is ~10ms, so serving HTML from the
     * Worker exhausts the budget and 503s the site.
     *
     * `drop-trailing-slash` keeps the canonical URLs the product already
     * uses: without it Cloudflare answers /pricing with a 307 to /pricing/,
     * because the file lives at pricing/index.html.
     *
     * `not_found_handling: "none"` is what makes the split work: a path with
     * no matching asset falls through to the Worker, which is how /api/* and
     * the still-dynamic authenticated routes keep working.
     */
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "660fd984521442f8be51b97740eb3d4a",
    },
  ],
  /*
   * Free-tier abuse control for sign-in/sign-up/forgot-password: no Cloudflare
   * zone exists to attach a WAF rate-limiting rule to (this Worker serves its
   * own workers.dev subdomain, not a zone the account manages), and Durable
   * Objects require the paid Workers plan. KV is the one primitive available
   * on the free plan that a stateless, horizontally-distributed Worker can
   * share a counter through. See app/rate-limit.ts for what this trades away.
   */
  "kv_namespaces": [
    {
      "binding": "VELYQ_RATE_LIMIT",
      "id": "e5e92ab477b344a6a311950d1fd4ecc0",
    },
  ],
  /*
   * These were configured by hand in the dashboard, which made every deploy a
   * hazard: `wrangler deploy` replaces plain-text vars with whatever the config
   * declares, so deploying from a config with no `vars` silently removed them
   * and the Worker came back up reporting auth as unconfigured. Declaring them
   * here makes a deploy reproducible instead of destructive.
   *
   * Every value is public. The Supabase URL and publishable key are the pair
   * Supabase intends to ship in a browser bundle, and they are already served
   * to every visitor. Nothing secret belongs in this file: the database
   * password reaches the Worker only through the Hyperdrive binding above, and
   * the service-role key is not used by this application at all.
   */
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://zvdqkmevjfwprexshpap.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_YEvRp91UoERENWagW5gY6g_8JHyPv_a",
    "VELYQ_APPLICATION_ORIGIN": "https://velyq-poc.joker2face1990.workers.dev",
    /*
     * Synthetic football data, and only data. VELYQ_SYNTHETIC_PREVIEW is
     * deliberately absent: it existed to keep the Worker usable while
     * Cloudflare had no database, and with it set requireCustomerPageAccess
     * grants access with no authentication check whenever the database is
     * briefly unreachable, while requireCustomerSession hands out FREE
     * entitlements instead of failing closed. Hyperdrive now serves this
     * Worker, so authorization is resolved for real on every request.
     */
    "VELYQ_CUSTOMER_INTELLIGENCE_MODE": "SYNTHETIC_DEMO",
  },
}
