{
  "name": "@velyq/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "corepack pnpm --filter @velyq/database... build && next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "corepack pnpm --filter @velyq/application... build && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@velyq/application": "workspace:*",
    "@velyq/auth": "workspace:*",
    "@velyq/contracts": "workspace:*",
    "@velyq/database": "workspace:*",
    "@velyq/decimal": "workspace:*",
    "@velyq/ui": "workspace:*",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "stripe": "18.5.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
