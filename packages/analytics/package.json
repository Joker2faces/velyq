{
  "name": "@velyq/analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./price-validity": {
      "types": "./src/price-validity.ts",
      "default": "./dist/price-validity.js"
    },
    "./decision-engine": {
      "types": "./src/decision-engine.ts",
      "default": "./dist/decision-engine.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@velyq/contracts": "workspace:*",
    "@velyq/decimal": "workspace:*"
  }
}
