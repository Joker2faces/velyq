{
  "name": "@velyq/application",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./forecast-cycle": {
      "types": "./src/forecast-cycle.ts",
      "default": "./dist/forecast-cycle.js"
    },
    "./provider-ingestion": {
      "types": "./src/provider-ingestion.ts",
      "default": "./dist/provider-ingestion.js"
    },
    "./provider-quota": {
      "types": "./src/provider-quota.ts",
      "default": "./dist/provider-quota.js"
    },
    "./odds-freshness": {
      "types": "./src/odds-freshness.ts",
      "default": "./dist/odds-freshness.js"
    },
    "./odds-movement": {
      "types": "./src/odds-movement.ts",
      "default": "./dist/odds-movement.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
