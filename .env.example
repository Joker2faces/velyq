# Public client values: use local Supabase values only; never add server secrets here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VELYQ_ADMIN_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical public origin used for production redirects (server-side only).
VELYQ_APPLICATION_ORIGIN=
VELYQ_CUSTOMER_INTELLIGENCE_MODE=SYNTHETIC_DEMO

# Server-only worker values. Use the transaction-pooler URL for application
# traffic and the direct URL only for migration tooling. Phase 1 accepts only
# synthetic provider mode.
VELYQ_DATABASE_URL=
VELYQ_DATABASE_DIRECT_URL=
VELYQ_PROVIDER_MODE=synthetic
VELYQ_QUEUE_NAME=velyq-synthetic

# Server-only Stripe Test Mode values. Never prefix secrets with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
