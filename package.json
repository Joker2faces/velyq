{
  "name": "velyq",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config tooling/vitest/vitest.config.mts",
    "test:integration": "vitest run --config tooling/vitest/vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "build": "turbo build",
    "bootstrap": "corepack pnpm install --frozen-lockfile && corepack pnpm verify",
    "verify": "corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:reset": "node tooling/scripts/unsupported-stage.mjs db:reset",
    "mock:replay": "node tooling/scripts/unsupported-stage.mjs mock:replay"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
